{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skigame",
  "compatibility_date": "2025-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ski-game",
      "database_id": "8e83d676-5230-4617-a50a-3ee1aff158c0",
      // Keep the existing local D1 data when binding the production database.
      "preview_database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "./migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ski-game-preview",
        "database_id": "59da0d6c-a2db-459b-8262-b82da201eef4",
        "migrations_dir": "./migrations"
      }
    ]
  }
}
